# JD Mart Full-Stack Environment Variables
PORT=3000
NODE_ENV=development

# Public URL of the app (e.g. https://jdmart.sl). When set, links inside emails
# must point to this site, which stops the email endpoint being used for phishing.
APP_URL=

# Comma-separated list of other origins allowed to call the API (optional).
# Leave empty when the web app and API are served from the same server.
ALLOWED_ORIGINS=

# Google Gemini API (Server-Side Only - Never expose to client)
GEMINI_API_KEY=

# Server-Side Transactional Email Service
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=notifications@jdmart.sl
# All admin_notification emails go to this address only
ADMIN_ALERT_EMAIL=admin@jdmart.sl

# Firebase Web Client Configuration (Public variables prefixed with VITE_)
# The server also uses VITE_FIREBASE_API_KEY to verify users' sign-in tokens.
VITE_FIREBASE_API_KEY=AIzaSyDg5ZwU7PWC3wBaEfSCqDY-kukJqph6il0
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0741191357.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0741191357
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0741191357.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=249850278683
VITE_FIREBASE_APP_ID=1:249850278683:web:5827b9deaa795d8e94d9be
VITE_FIREBASE_DATABASE_ID=ai-studio-jdmart-f4788b01-f62e-4dce-b9ab-dc6dd74ac3dc
